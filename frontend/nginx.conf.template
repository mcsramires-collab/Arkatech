server {
  listen 80;
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  # BFF do painel interno:
  # - navegador chama /api/... no mesmo host do frontend;
  # - a chave interna existe somente no processo Nginx;
  # - Authorization do navegador continua sendo repassado quando houver sessão real.
  location /api/ {
    proxy_pass ${BACKEND_API_URL};
    proxy_http_version 1.1;
    proxy_ssl_server_name on;

    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

    proxy_set_header Authorization $http_authorization;
    proxy_set_header x-internal-api-key "${INTERNAL_API_KEY}";
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}
