# ----------------------------------------------------
# ARCKATECH - Variáveis de Produção (.env.production.example)
# ----------------------------------------------------

NODE_ENV=production
PORT=3000

# Banco de Dados PostgreSQL Produção
POSTGRES_USER=arckatech_prod_user
POSTGRES_PASSWORD=alterar_para_uma_senha_forte_e_aleatoria_aqui
POSTGRES_DB=arckatech_prod_db

# Redis Produção com Senha Explicita
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=alterar_senha_redis_prod_aqui

# Segredos JWT & Criptografia AES-256 (ISO 27001 / LGPD)
JWT_SECRET=super_secret_jwt_key_arckatech_production_2026
ENCRYPTION_KEY=32_bytes_super_secret_key_aes256_gcm!!

# Chave de acesso aos painéis internos (/admin, /broker, /internal) — gere com
# openssl rand -hex 32. Sem essa variável configurada, a API bloqueia essas rotas.
INTERNAL_API_KEY=gerar_com_openssl_rand_hex_32

# URLs Públicas
PUBLIC_API_URL=https://api.arckatech.com.br
PUBLIC_APP_URL=https://app.arckatech.com.br
