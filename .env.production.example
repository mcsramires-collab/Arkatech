# ----------------------------------------------------
# ARCKATECH - Variáveis de Ambiente (PRODUÇÃO)
# Na VPS/Easypanel, copie para ".env.production" e
# preencha com valores reais e únicos.
# NUNCA versione o arquivo ".env.production" no Git.
# ----------------------------------------------------

NODE_ENV=production
PORT=3000

# Banco de Dados PostgreSQL
POSTGRES_USER=arckatech_user
# Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=GERAR_SENHA_FORTE_UNICA
POSTGRES_DB=arckatech_db

# Redis / Filas BullMQ
# Gere com: openssl rand -hex 24
REDIS_PASSWORD=GERAR_SENHA_FORTE_UNICA

# Segurança & Criptografia (ISO 27001 / LGPD)
# Gere com: openssl rand -hex 64
JWT_SECRET=GERAR_COM_openssl_rand_hex_64
# Gere com: openssl rand -base64 32   (precisa ter 32 bytes reais para AES-256-GCM)
ENCRYPTION_KEY=GERAR_COM_openssl_rand_base64_32

# URL pública da API (usada no BUILD do frontend — Vite grava isso no bundle)
PUBLIC_API_URL=https://api.seudominio.com.br
