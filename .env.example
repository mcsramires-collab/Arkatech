# ----------------------------------------------------
# ARCKATECH - Variáveis de Ambiente (.env.example)
# ----------------------------------------------------

NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
POSTGRES_USER=arckatech_user
POSTGRES_PASSWORD=arckatech_secure_password_2026
POSTGRES_DB=arckatech_db
DATABASE_URL=postgresql://arckatech_user:arckatech_secure_password_2026@localhost:5432/arckatech_db?schema=public

# Redis / Filas BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Segurança & Criptografia (ISO 27001 / LGPD)
JWT_SECRET=super_secret_jwt_key_arckatech_averbacao_2026
ENCRYPTION_KEY=32_bytes_secret_key_for_aes256_gcm!!

# Frontend App URL
VITE_API_URL=http://localhost:3000
