# ----------------------------------------------------
# ARCKATECH - Variáveis de Ambiente (DESENVOLVIMENTO)
# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA use estes valores em produção.
# ----------------------------------------------------

NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
POSTGRES_USER=arckatech_user
POSTGRES_PASSWORD=arckatech_dev_password_troque_local
POSTGRES_DB=arckatech_db
DATABASE_URL=postgresql://arckatech_user:arckatech_dev_password_troque_local@localhost:5432/arckatech_db?schema=public

# Redis / Filas BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Segurança & Criptografia (ISO 27001 / LGPD)
# Gere com: openssl rand -hex 64
JWT_SECRET=GERAR_COM_openssl_rand_hex_64
# Gere com: openssl rand -base64 32   (precisa ter 32 bytes reais para AES-256-GCM)
ENCRYPTION_KEY=GERAR_COM_openssl_rand_base64_32

# Frontend App URL
VITE_API_URL=http://localhost:3000
