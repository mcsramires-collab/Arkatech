# ----------------------------------------------------
# ARCKATECH - Variáveis de Ambiente (.env.example)
# ----------------------------------------------------

NODE_ENV=development
PORT=3000

# Banco de Dados PostgreSQL
POSTGRES_USER=arckatech_user
POSTGRES_PASSWORD=arckatech_secure_password_2026
POSTGRES_DB=arckatech_db
DATABASE_URL=postgresql://arckatech_user:arckatech_secure_password_2026@localhost:5432/arckatech_db?schema=public

# Redis / Filas BullMQ
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Segurança & Criptografia (ISO 27001 / LGPD)
JWT_SECRET=super_secret_jwt_key_arckatech_averbacao_2026
ENCRYPTION_KEY=32_bytes_secret_key_for_aes256_gcm!!
INTERNAL_API_KEY=dev_internal_key_change_me

# Frontend App URL
VITE_API_URL=http://localhost:3000

# Resend (envio do e-mail de convite de ativação — ver services/emailService.ts). Sem
# RESEND_API_KEY configurada, o envio é apenas logado (não falha o cadastro). Gere a chave em
# https://resend.com e configure o domínio de envio (RESEND_FROM_EMAIL) antes de usar em produção.
RESEND_API_KEY=
RESEND_FROM_EMAIL=convites@arckatech.com.br

# URL pública do Portal do Segurado (arckatech-cargo-portal) — usada para montar o link do
# e-mail de convite. Em dev local, o padrão já é o do `vite dev` (porta 5173).
PUBLIC_APP_URL=http://localhost:5173

# Pacote 6 — despacho de averbação para seguradora externa.
# Fallback global (útil em homologação); em produção prefira uma dupla por insurer_id.
INSURER_ADAPTER_URL=
INSURER_ADAPTER_TOKEN=
# Exemplo para insurer_id="ins_porto_01":
# INSURER_ADAPTER_URL_INS_PORTO_01=https://adapter.exemplo.com/averbacoes
# INSURER_ADAPTER_TOKEN_INS_PORTO_01=segredo_fornecido_pelo_adapter
INSURER_DISPATCH_TIMEOUT_MS=15000
INSURER_DISPATCH_MAX_ATTEMPTS=8

# Worker: faz polling HTTP da própria API; ele não escreve diretamente no data_store.json.
ARCKATECH_API_BASE_URL=http://localhost:3000/api/v1
INSURER_DISPATCH_POLL_MS=5000
INSURER_DISPATCH_BATCH_LIMIT=20
